---
layout: layouts/inner-flare-base.njk
pagination:
  data: collections.innerFlarePostTopics
  size: 1
  alias: tag
permalink: "/inner-flare/blog/tags/{{ tag | slugify }}/"
eleventyComputed:
  title: "{{ tag | topicLabel }}"
  description: "Inner Flare blog posts about {{ tag | topicLabel | lower }}."
---
<div class="blog-wrap">
  <p class="post-meta"><a href="/inner-flare/blog/">← All posts</a></p>
  <h1>{{ tag | topicLabel }}</h1>
  <p class="blog-intro">Posts tagged &ldquo;{{ tag | topicLabel }}&rdquo;.</p>

  <ul class="post-list">
    {%- for post in collections.innerFlarePosts %}
    {%- if tag in post.data.tags %}
    <li class="post-card">
      <a href="{{ post.url }}">
        <p class="post-date">{{ post.data.date | readableDate }}</p>
        <h2>{{ post.data.title }}</h2>
        <p>{{ post.data.description }}</p>
      </a>
    </li>
    {%- endif %}
    {%- endfor %}
  </ul>
</div>
